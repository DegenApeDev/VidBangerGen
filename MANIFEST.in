include .env.example
include CONTRIBUTING.md
include LICENSE
include NOTICE
include README.md
include SECURITY.md
include THIRD_PARTY.md
include package.json
include package-lock.json
recursive-include apps/api/workflows *.json
recursive-include apps/web/dist *
recursive-include apps/web/src *.css *.tsx
include apps/web/index.html
include apps/web/package.json
include apps/web/package-lock.json
include apps/web/tsconfig.json
include apps/web/vite.config.ts
recursive-include benchmarks *.json *.md
recursive-include deploy *
recursive-include docs *.md
recursive-include scripts *.py *.sh
recursive-include tests *.py
global-exclude *.py[cod]
global-exclude __pycache__
