# VidBangerGen creates .env interactively with:
#   python3 scripts/setup.py setup
#
# This file is a portable reference for unattended/manual configuration. Do not
# put credentials in ComfyUI URLs; keep workers on a private network or protect
# them with a reverse proxy.

VBG_SETUP_COMPLETE=true
VBG_SETUP_VERSION=1

# Application storage
VBG_DATA_DIR=./data

# One or more existing ComfyUI API workers. The setup wizard automatically
# probes local ports 8188/8189 or validates remote URLs supplied by the user.
VBG_COMFYUI_URLS=http://127.0.0.1:8188
VBG_UPLOAD_CAPABLE_URLS=http://127.0.0.1:8188

# Set these only when VidBangerGen exclusively owns the corresponding workers.
# Shared workers must remain absent from both lists.
VBG_MANAGED_COMFY_URLS=
VBG_INTERRUPT_CAPABLE_URLS=

# Portable execution target map. The ID is persisted with queued jobs; the label
# is what operators see in the interface.
VBG_EXECUTION_TARGETS_JSON='[{"id":"primary","label":"Primary ComfyUI","kind":"comfyui","urls":["http://127.0.0.1:8188"],"capabilities":["ltx-generation","continuation","latent-upscale","post-upscale"],"description":"Primary LTX 2.3 inference pool"}]'

# Optional read-only SSH access for the GPU Monitor and model inventory.
VBG_SSH_HOST=
VBG_REMOTE_LORA_DIR=

# Local creative director and optional visual judge
VBG_OLLAMA_URL=http://127.0.0.1:11434
VBG_DIRECTOR_MODEL=bonsai-27b:latest
VBG_VISION_MODEL=qwen3-vl:8b
VBG_VISION_SCORING_ENABLED=false

# API limits and browser access
VBG_GENERATION_TIMEOUT=1200
VBG_MAX_UPLOAD_MB=100
VBG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
